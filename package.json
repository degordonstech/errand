{
  "name": "mypaddy",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent in Telegram that acts first: reminders, follow-ups, accountability and small jobs, built on Meta's Muse models.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.45.0",
    "p-queue": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "resend": "^6.34.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
